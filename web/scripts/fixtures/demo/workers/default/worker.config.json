{
  "name": "raft-game-demo",
  "compatibilityDate": "2026-11-04",
  "assets": {
    "notFoundHandling": "single-page-application",
    "runWorkerFirst": ["/api/*", "/ws/*"]
  },
  "domains": ["raft-demo.kizuku-hackathon.work"],
  "limits": {
    "cpuMs": 50
  },
  "observability": {
    "enabled": true,
    "redactQueryString": true,
    "logs": {
      "enabled": true,
      "headSamplingRate": 1
    }
  },
  "workersDev": false,
  "previewUrls": false,
  "env": {
    "ALLOWED_ORIGINS": {
      "type": "text",
      "value": "https://raft.kizuku-hackathon.work,https://raft-demo.kizuku-hackathon.work"
    },
    "DEMO_CONTROLS": {
      "type": "text",
      "value": "1"
    },
    "BUILD_ID": {
      "type": "text",
      "value": "git:fixture"
    },
    "CONTAINER_INSTANCE": {
      "type": "text",
      "value": "standard-1"
    },
    "GAME_SESSION": {
      "type": "durable-object",
      "worker": "raft-game-demo",
      "exportName": "GameSession"
    },
    "COST_GUARD": {
      "type": "durable-object",
      "worker": "raft-game",
      "exportName": "CostGuard"
    },
    "SESSION_SIGNING_KEY": {
      "type": "secret"
    },
    "TURNSTILE_SECRET": {
      "type": "secret"
    },
    "SESSION_RATE_LIMIT": {
      "type": "rate-limit",
      "namespace": "1002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    "REPLAYS": {
      "type": "r2",
      "name": "raft-game-replays"
    }
  },
  "exports": {
    "GameSession": {
      "type": "durable-object",
      "storage": "sqlite",
      "container": "raft-game-demo-server"
    }
  },
  "manifest": {
    "type": "partial",
    "mainModule": "index.js",
    "modules": {}
  }
}
