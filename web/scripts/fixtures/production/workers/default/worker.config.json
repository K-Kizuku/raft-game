{
  "name": "raft-game",
  "compatibilityDate": "2026-11-04",
  "assets": {
    "notFoundHandling": "single-page-application",
    "runWorkerFirst": ["/api/*", "/ws/*"]
  },
  "domains": ["raft.kizuku-hackathon.work"],
  "limits": {
    "cpuMs": 50
  },
  "observability": {
    "enabled": true,
    "redactQueryString": true,
    "logs": {
      "enabled": true,
      "headSamplingRate": 1
    }
  },
  "workersDev": false,
  "previewUrls": false,
  "env": {
    "ALLOWED_ORIGINS": {
      "type": "text",
      "value": "https://raft.kizuku-hackathon.work,https://raft-demo.kizuku-hackathon.work"
    },
    "DEMO_CONTROLS": {
      "type": "text",
      "value": "0"
    },
    "BUILD_ID": {
      "type": "text",
      "value": "git:fixture"
    },
    "CONTAINER_INSTANCE": {
      "type": "text",
      "value": "lite"
    },
    "GAME_SESSION": {
      "type": "durable-object",
      "worker": "raft-game",
      "exportName": "GameSession"
    },
    "COST_GUARD": {
      "type": "durable-object",
      "worker": "raft-game",
      "exportName": "CostGuard"
    },
    "GUARDS": {
      "type": "json",
      "value": {
        "budget": {
          "enabled": true,
          "monthlyUsd": 30,
          "dailyUsd": 1
        },
        "gameTime": {
          "maxMinutes": 30,
          "maxAlarms": 20
        },
        "turnstile": {
          "enabled": true
        },
        "rateLimit": {
          "enabled": true,
          "perIpPerMinute": 10
        },
        "cpuMs": 50,
        "acceptGames": true,
        "unitCostUsd": {
          "lite": 0.0065,
          "standard-1": 0.04
        }
      }
    },
    "SESSION_SIGNING_KEY": {
      "type": "secret"
    },
    "TURNSTILE_SECRET": {
      "type": "secret"
    },
    "ADMIN_TOKEN": {
      "type": "secret"
    },
    "SESSION_RATE_LIMIT": {
      "type": "rate-limit",
      "namespace": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    "REPLAYS": {
      "type": "r2",
      "name": "raft-game-replays"
    }
  },
  "exports": {
    "GameSession": {
      "type": "durable-object",
      "storage": "sqlite",
      "container": "raft-game-server"
    },
    "CostGuard": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "manifest": {
    "type": "partial",
    "mainModule": "index.js",
    "modules": {}
  }
}
